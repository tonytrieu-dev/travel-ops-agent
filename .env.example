# ── Travel Agent — environment configuration ─────────────────────────────────
# Copy to `.env` and fill in the free API keys. Nothing here requires a credit card.

# Cerebras — gpt-oss-120b inference.
# Get one at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-api-key

GEMINI_API_KEY=your-gemini-api-key

# SearchApi.io Google Flights — 100 free searches, no card.
# https://www.searchapi.io/
SEARCHAPI_API_KEY=your-searchapi-key

# Tavily — AI-agent web search, 1,000 free credits/month, no card.
# https://www.tavily.com/
TAVILY_API_KEY=your-tavily-key

# PostgreSQL. The async URL is used by the app (asyncpg); DBOS derives a sync URL from it.
# Local Homebrew default (peer auth, your macOS username, no password):
DATABASE_URL=postgresql+asyncpg://tony@localhost:5432/travel_agent

# Flight-API mode. `true` (default) calls SearchApi live — use for the real demo.
# `false` replays recorded-REAL cassettes (captured payloads) to protect the 100-search
# quota during dev reloads / tests / evals. It NEVER fabricates data.
USE_LIVE_FLIGHT_API=true

# Frontend origin allowed by CORS (no wildcard).
FRONTEND_ORIGIN=http://localhost:5173

# Zero-trust enforcement is ON by default. Leave ZERO_TRUST_ENFORCED unset (or =true) for the
# real posture. With no explicit signing secret the app generates a fresh per-process key, so an
# out-of-the-box run is enforced and unforgeable; set an explicit strong secret below so tokens
# survive a restart and are shared across processes in a real deployment.
# ZERO_TRUST_ENFORCED=true
# ZERO_TRUST_SIGNING_SECRET=change-me-to-a-long-random-string
#
# Set ZERO_TRUST_ENFORCED=false only for local work that predates the auth boundary.

# Optional — Slack HITL connector. All three must be set for the Connectors tab to allow
# enabling it. See docs/SLACK_SETUP.md for how to get these values.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL_ID=
